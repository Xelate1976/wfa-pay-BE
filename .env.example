# Copy this file to .env and fill in real values. Never commit .env.

# --- Stripe (required) ---------------------------------------------------
# Dashboard > Developers > API keys. Use the sk_test_ key first.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Dashboard > Developers > Webhooks > your endpoint > Signing secret
# (or the value `stripe listen` prints when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Lock this down to your real front-end URL once deployed, e.g.
# https://your-app.claudeusercontent.com — "*" is fine for local testing.
ALLOWED_ORIGIN=*

# --- WhatsApp via Twilio (optional — leave blank to skip) ---------------
# console.twilio.com. TWILIO_WHATSAPP_FROM defaults to Twilio's sandbox
# number (+14155238886) until you apply for a real WhatsApp sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
MERCHANT_WHATSAPP_NUMBER=+65XXXXXXXX
SUPPLIER_WHATSAPP_NUMBER=

# --- Email via Resend (optional — leave blank to skip) -------------------
# resend.com > API Keys. RECEIPT_FROM_EMAIL must be on a domain you've
# verified with Resend.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=receipts@yourdomain.com

PORT=4000
